# Copy to .env and fill in. Only the providers you actually have keys for need
# values — the router skips anything unconfigured and falls through the chain.

# ── host-wrapper ────────────────────────────────────────────────────────────
# Runs on the HOST, not in Docker: it shells out to the `claude` CLI so the work
# bills to a Claude subscription instead of metered API tokens.
PORT=5501
WRAPPER_URL=http://host.docker.internal:5501

# ── LLM provider keys (free tiers first, claude-cli last) ───────────────────
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Leave BLANK on purpose. With no API key the router can only reach Claude
# through the CLI provider, so Claude usage can never silently fall onto
# metered tokens.
ANTHROPIC_API_KEY=
